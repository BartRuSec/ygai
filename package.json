{
  "name": "ygai",
  "version": "0.1.4",
  "description": "Yet Another Gen AI CLI Tool",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BartRuSec/ygai.git"
  },
  "bugs": {
    "url": "https://github.com/BartRuSec/ygai/issues"
  },
  "homepage": "https://github.com/BartRuSec/ygai#readme",
  "bin": {
    "ygai": "dist/cli.js"
  },
  "scripts": {
    "build": "node esbuild.config.mjs && shx chmod +x dist/cli.js",
    "build:tsc": "tsc && shx chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "test": "npm run build && node -e \"const pkg = require('./dist/index.js'); if (typeof pkg.configureProgram !== 'function') throw new Error('main entrypoint smoke test failed')\"",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "keywords": [
    "cli",
    "ai",
    "llm",
    "langchain"
  ],
  "author": "BartRuSec",
  "license": "MPL-2.0",
  "dependencies": {
    "@langchain/core": "^1.1.46",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/mcp-adapters": "^1.1.3",
    "chalk": "^5.6.0",
    "commander": "^14.0.3",
    "exceljs": "^4.4.0",
    "isbinaryfile": "^6.0.0",
    "js-tiktoken": "^1.0.17",
    "js-yaml": "^4.1.0",
    "mammoth": "^1.9.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "officeparser": "^7.0.3",
    "pdf-parse": "^2.4.5",
    "supports-color": "^10.2.0",
    "turndown": "^7.2.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.8.0",
    "esbuild": "^0.28.0",
    "rimraf": "^6.0.1",
    "shx": "^0.4.0",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
